# LLM (Anthropic). Se você já fez `ant auth login`, a chave é opcional.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
JUDGE_MODEL=claude-opus-5-5

# Embeddings locais (fastembed, ONNX, sem custo de API)
# Padrão leve (220 MB), cabe no Streamlit Community Cloud:
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Mais preciso (2,2 GB), para servidor com 4 GB+ de RAM (use MIN_SCORE=0.835):
# EMBEDDING_MODEL=intfloat/multilingual-e5-large

# Busca híbrida: vetorial + BM25 combinadas por RRF (só no store local)
HYBRID=true

# Vector store: "local" (arquivo JSON em ./index) ou "pinecone"
VECTOR_STORE=local
PINECONE_API_KEY=
PINECONE_INDEX=rag-juridico-poc

# Recuperação
TOP_K=5
# Similaridade mínima (cosseno) do melhor trecho para sequer chamar o LLM.
# Calibrado no dataset de avaliação (ver README). Recalibrar com perguntas reais.
MIN_SCORE=0.53
